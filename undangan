  <audio id="wedding-audio" src="audio/wedding.mp3" loop preload="none"></audio>
  <div class="music" id="music-widget"><button type="button" id="music-button" aria-label="Putar musik" aria-pressed="false"><span id="music-icon">▶</span><span id="music-label">Putar musik</span><span aria-hidden="true">♫</span></button><span class="music-status" id="music-status" role="status" hidden></span></div>
  <script>
  (function(){
    "use strict";
    var weddingTime=new Date("2026-09-30T19:15:00+08:00").getTime();
    function updateCountdown(){var diff=Math.max(0,weddingTime-Date.now());var values={days:Math.floor(diff/86400000),hours:Math.floor(diff/3600000)%24,minutes:Math.floor(diff/60000)%60,seconds:Math.floor(diff/1000)%60};Object.keys(values).forEach(function(key){document.querySelector('[data-unit="'+key+'"]').textContent=String(values[key]).padStart(2,"0")})}
    updateCountdown();setInterval(updateCountdown,1000);
    var menu=document.getElementById("menu"),nav=document.getElementById("nav");
    menu.addEventListener("click",function(){var open=nav.classList.toggle("open");menu.setAttribute("aria-expanded",String(open));menu.setAttribute("aria-label",open?"Tutup menu":"Buka menu");menu.textContent=open?"×":"☰"});
    nav.querySelectorAll("a").forEach(function(a){a.addEventListener("click",function(){nav.classList.remove("open");menu.setAttribute("aria-expanded","false");menu.textContent="☰"})});
    if("IntersectionObserver" in window){document.documentElement.classList.add("motion");var observer=new IntersectionObserver(function(entries){entries.forEach(function(entry){if(entry.isIntersecting){entry.target.classList.add("visible");observer.unobserve(entry.target)}})},{threshold:.1});document.querySelectorAll(".reveal").forEach(function(el){observer.observe(el)})}
    if(!matchMedia("(prefers-reduced-motion: reduce)").matches){var pending=false;addEventListener("scroll",function(){if(pending)return;pending=true;requestAnimationFrame(function(){document.documentElement.style.setProperty("--shift",Math.min(scrollY*.12,85)+"px");pending=false})},{passive:true})}
    var audio=document.getElementById("wedding-audio"),music=document.getElementById("music-widget"),musicButton=document.getElementById("music-button"),musicIcon=document.getElementById("music-icon"),musicLabel=document.getElementById("music-label"),musicStatus=document.getElementById("music-status");
    function musicMessage(text){musicStatus.textContent=text;musicStatus.hidden=!text}
    function musicState(playing){musicIcon.textContent=playing?"Ⅱ":"▶";musicLabel.textContent=playing?"Jeda musik":"Putar musik";musicButton.setAttribute("aria-label",musicLabel.textContent);musicButton.setAttribute("aria-pressed",String(playing))}
    function startMusic(){audio.play().then(function(){musicMessage("")}).catch(function(){musicState(false);musicMessage("Ketuk putar untuk memulai musik.")})}
    audio.addEventListener("play",function(){musicState(true)});audio.addEventListener("pause",function(){musicState(false)});audio.addEventListener("error",function(){musicState(false);musicMessage("Musik belum dapat dimuat.")});
    document.getElementById("open-invitation").addEventListener("click",function(){music.classList.add("show");startMusic();document.getElementById("countdown").scrollIntoView({behavior:"smooth"})});
    musicButton.addEventListener("click",function(){if(audio.paused)startMusic();else audio.pause()});
    var gallery=document.getElementById("gallery-grid");function moveGallery(direction){var card=gallery.querySelector(".gallery-item");gallery.scrollBy({left:direction*(card.getBoundingClientRect().width+14),behavior:"smooth"})}document.getElementById("gallery-prev").addEventListener("click",function(){moveGallery(-1)});document.getElementById("gallery-next").addEventListener("click",function(){moveGallery(1)});
    var local=location.protocol==="file:";if(local)document.querySelectorAll(".local-note").forEach(function(el){el.style.display="block"});
    function feedback(id,text,ok){var el=document.getElementById(id);el.textContent=text;el.classList.toggle("ok",!!ok)}
    function storeLocal(key,item){var data=JSON.parse(localStorage.getItem(key)||"[]");data.unshift(item);localStorage.setItem(key,JSON.stringify(data));return data}
    document.querySelectorAll('[name="attendance"]').forEach(function(radio){radio.addEventListener("change",function(){document.getElementById("guest-field").hidden=document.querySelector('[name="attendance"]:checked').value==="no"})});
    document.getElementById("rsvp-form").addEventListener("submit",async function(event){event.preventDefault();var form=event.currentTarget,button=form.querySelector("button[type=submit]"),name=form.elements.name.value.trim(),attendance=form.elements.attendance.value,guests=attendance==="yes"?Number(form.elements.guests.value):0;if(name.length<2||name.length>80)return;button.disabled=true;feedback("rsvp-feedback","Mengirim konfirmasi...",false);try{if(local)storeLocal("arya-emira-rsvps",{name:name,attendance:attendance,guests:guests});else{var response=await fetch("api/rsvp",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({name:name,attendance:attendance,guests:guests})});if(!response.ok)throw Error("Gagal menyimpan")}feedback("rsvp-feedback","Terima kasih, konfirmasi Anda sudah tersimpan.",true);form.reset();document.getElementById("guest-field").hidden=false}catch(error){feedback("rsvp-feedback","Maaf, konfirmasi belum terkirim. Coba lagi.",false)}finally{button.disabled=false}});
    function renderWishes(items){var list=document.getElementById("wish-list");list.replaceChildren();if(!items.length){var empty=document.createElement("p");empty.className="empty";empty.textContent="Belum ada ucapan. Jadilah yang pertama mengirim doa.";list.appendChild(empty);return}items.slice(0,30).forEach(function(wish){var card=document.createElement("article"),avatar=document.createElement("div"),body=document.createElement("div"),meta=document.createElement("div"),name=document.createElement("strong"),date=document.createElement("time"),message=document.createElement("p");card.className="wish-card";avatar.className="avatar";avatar.setAttribute("aria-hidden","true");avatar.textContent=wish.name.charAt(0).toUpperCase();meta.className="wish-meta";name.textContent=wish.name;date.dateTime=wish.createdAt;date.textContent=new Intl.DateTimeFormat("id-ID",{day:"numeric",month:"short",year:"numeric",timeZone:"Asia/Makassar"}).format(new Date(wish.createdAt));message.textContent=wish.message;meta.append(name,date);body.append(meta,message);card.append(avatar,body);list.appendChild(card)})}
    var wishes=[];async function loadWishes(){try{if(local)wishes=JSON.parse(localStorage.getItem("arya-emira-wishes")||"[]");else{var response=await fetch("api/wishes",{cache:"no-store"});if(!response.ok)throw Error("Gagal memuat");wishes=(await response.json()).wishes}renderWishes(wishes)}catch(error){document.getElementById("wish-list").innerHTML='<p class="empty">Ucapan belum dapat dimuat. Muat ulang halaman untuk mencoba lagi.</p>'}}loadWishes();
    document.getElementById("wish-form").addEventListener("submit",async function(event){event.preventDefault();var form=event.currentTarget,button=form.querySelector("button[type=submit]"),name=form.elements.name.value.trim(),message=form.elements.message.value.trim();if(name.length<2||name.length>80||message.length<3||message.length>600)return;button.disabled=true;feedback("wish-feedback","Mengirim ucapan...",false);try{var wish;if(local){wish={id:Date.now(),name:name,message:message,createdAt:new Date().toISOString()};wishes=storeLocal("arya-emira-wishes",wish)}else{var response=await fetch("api/wishes",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({name:name,message:message})});if(!response.ok)throw Error("Gagal menyimpan");wish=(await response.json()).wish;wishes.unshift(wish)}renderWishes(wishes);form.reset();feedback("wish-feedback","Terima kasih, ucapan Anda sudah tampil.",true)}catch(error){feedback("wish-feedback","Maaf, ucapan belum terkirim. Coba lagi.",false)}finally{button.disabled=false}});
    document.getElementById("copy-account").addEventListener("click",async function(){var button=this;try{await navigator.clipboard.writeText("11111123938");button.textContent="Tersalin";setTimeout(function(){button.textContent="Salin nomor rekening"},2500)}catch(error){var range=document.createRange();range.selectNodeContents(document.getElementById("account-number"));getSelection().removeAllRanges();getSelection().addRange(range);button.textContent="Nomor dipilih, silakan salin"}});
  })();
  </script>
