<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#0b382f">
  <meta name="description" content="Undangan pernikahan Arya Saloka dan Emira Feriha, 30 September 2026 di Makassar.">
  <title>Arya Saloka &amp; Emira Feriha | Undangan Pernikahan</title>
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml;base64,">
  <link rel="preconnect" href="https://fonts.googleapis.com">
